{
  "name": "devarchitect",
  "version": "0.1.0",
  "description": "DevArchitect — Understand your codebase. Improve its architecture. Engineer with confidence.",
  "type": "module",
  "bin": {
    "devarchitect": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "architecture",
    "engineering-intelligence",
    "dependency-graph",
    "clean-architecture",
    "feature-sliced",
    "code-health",
    "blast-radius",
    "refactoring",
    "code-smells",
    "rerenders"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Addy3131/devarchitect.git"
  },
  "homepage": "https://github.com/Addy3131/devarchitect#readme",
  "bugs": {
    "url": "https://github.com/Addy3131/devarchitect/issues"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/bin.js"
  },
  "dependencies": {
    "@devarchitect/analyzers": "workspace:*",
    "@devarchitect/config": "workspace:*",
    "@devarchitect/contracts": "workspace:*",
    "@devarchitect/core": "workspace:*",
    "@devarchitect/generator": "workspace:*",
    "@devarchitect/graph": "workspace:*",
    "@devarchitect/parsers": "workspace:*",
    "@devarchitect/reporting": "workspace:*",
    "@devarchitect/rules": "workspace:*",
    "commander": "^13.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3"
  }
}

