{
  "name": "devarchitect",
  "displayName": "DevArchitect",
  "description": "Understand your codebase. Prevent architectural drift. Real-time architecture health, change blast radius, and interactive studio inside VS Code and Cursor",
  "version": "0.1.3",
  "publisher": "devarchitect",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Addy3131/devarchitect.git"
  },
  "homepage": "https://github.com/Addy3131/devarchitect#readme",
  "bugs": {
    "url": "https://github.com/Addy3131/devarchitect/issues"
  },
  "icon": "resources/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "badges": [
    {
      "url": "https://img.shields.io/npm/v/devarchitect-cli.svg?style=flat-square&color=blue&label=npm%20cli",
      "href": "https://www.npmjs.com/package/devarchitect-cli",
      "description": "NPM CLI"
    },
    {
      "url": "https://img.shields.io/badge/license-MIT-green.svg?style=flat-square",
      "href": "https://github.com/Addy3131/devarchitect/blob/main/LICENSE",
      "description": "License"
    }
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Testing",
    "Visualization"
  ],
  "keywords": [
    "architecture",
    "blast-radius",
    "code-health",
    "dependency-graph",
    "refactoring"
  ],
  "activationEvents": [
    "onView:devarchitect.healthView",
    "onView:devarchitect.blastView",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devarchitect.openStudioWebview",
        "title": "DevArchitect: Open Architecture Graph in Editor",
        "icon": "$(graph)"
      },
      {
        "command": "devarchitect.launchStudio",
        "title": "DevArchitect: Open Web Studio (Browser)",
        "icon": "$(globe)"
      },
      {
        "command": "devarchitect.healthCheck",
        "title": "DevArchitect: Refresh Architecture Health",
        "icon": "$(refresh)"
      },
      {
        "command": "devarchitect.refreshBlastRadius",
        "title": "DevArchitect: Refresh Active File Blast Radius",
        "icon": "$(refresh)"
      },
      {
        "command": "devarchitect.selectProjectRoot",
        "title": "DevArchitect: Select Target Project Folder",
        "icon": "$(folder)"
      },
      {
        "command": "devarchitect.inspectCurrentFile",
        "title": "DevArchitect: Inspect File Blast Radius",
        "icon": "$(flame)"
      },
      {
        "command": "devarchitect.validateArchitecture",
        "title": "DevArchitect: Validate Architecture Rules",
        "icon": "$(shield)"
      },
      {
        "command": "devarchitect.auditEnv",
        "title": "DevArchitect: Audit Environment Variables & Secrets",
        "icon": "$(key)"
      },
      {
        "command": "devarchitect.fixSmells",
        "title": "DevArchitect: Run Safe Fixer (Dry Run)",
        "icon": "$(tools)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "devarchitect.openStudioWebview",
          "when": "view == devarchitect.healthView",
          "group": "navigation@1"
        },
        {
          "command": "devarchitect.selectProjectRoot",
          "when": "view == devarchitect.healthView",
          "group": "navigation@2"
        },
        {
          "command": "devarchitect.healthCheck",
          "when": "view == devarchitect.healthView",
          "group": "navigation@3"
        },
        {
          "command": "devarchitect.refreshBlastRadius",
          "when": "view == devarchitect.blastView",
          "group": "navigation@1"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devarchitect-sidebar",
          "title": "DevArchitect",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "devarchitect-sidebar": [
        {
          "id": "devarchitect.healthView",
          "name": "Architecture Health"
        },
        {
          "id": "devarchitect.blastView",
          "name": "Active File Blast Radius"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "package": "tsup && npx @vscode/vsce package --no-dependencies"
  },
  "dependencies": {
    "@devarchitect/analyzers": "workspace:*",
    "@devarchitect/config": "workspace:*",
    "@devarchitect/contracts": "workspace:*",
    "@devarchitect/core": "workspace:*",
    "@devarchitect/graph": "workspace:*",
    "@devarchitect/rules": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/vscode": "^1.85.0",
    "rimraf": "^6.0.1",
    "tsup": "^9.0.0",
    "typescript": "^5.7.3"
  }
}
