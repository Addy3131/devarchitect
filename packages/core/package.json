{
  "name": "@devarchitect/core",
  "version": "0.1.0",
  "description": "DevArchitect core repository discovery, framework detection, and indexing engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
