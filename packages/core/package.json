  "dependencies": {
    "@devarchitect/config": "workspace:*",
    "@devarchitect/contracts": "workspace:*",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3"
  }
}

