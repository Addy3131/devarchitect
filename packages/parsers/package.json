{
  "name": "@devarchitect/parsers",
  "version": "0.1.0",
  "description": "DevArchitect parser adapters, AST traversal, import resolution, and complexity analysis",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@devarchitect/contracts": "workspace:*",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.1"
  }
}

